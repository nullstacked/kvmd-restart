post_install() {
    echo ">>> Running kvmd-restart patches..."
    /usr/share/kvmd-restart/apply-patches.sh
    echo ">>> Restarting kvmd to load GPIO config..."
    systemctl restart kvmd 2>/dev/null || true
}

post_upgrade() {
    echo ">>> Running kvmd-restart patches..."
    /usr/share/kvmd-restart/apply-patches.sh
    echo ">>> Restarting kvmd to load GPIO config..."
    systemctl restart kvmd 2>/dev/null || true
}

pre_remove() {
    echo ">>> kvmd-restart removed."
    echo ">>> Run 'pacman -S kvmd' to restore original web files."
    echo ">>> Run 'systemctl restart kvmd' to reload GPIO config."
}
